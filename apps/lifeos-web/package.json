{
  "name": "@lifeos/web",
  "private": true,
  "version": "0.0.0",
  "description": "LifeOS selainapp — yksi responsiivinen React/TypeScript/Vite-app mobiili- ja desktop-selaimiin.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "tsc --noEmit && vite build --mode e2e",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:matrix": "playwright test"
  },
  "dependencies": {
    "@lifeos/capabilities": "^0.0.0",
    "@lifeos/config": "^0.0.0",
    "@lifeos/data": "^0.0.0",
    "@lifeos/domain": "^0.0.0",
    "@lifeos/ui": "^0.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "20.14.5",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.1"
  }
}
