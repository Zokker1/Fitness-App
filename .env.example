# LifeOS dev-ympäristö (T029). Kopioi: Copy-Item .env.example .env
# .env on gitignoressa — älä commitoi oikeita arvoja.
# Sallitut VITE_-avaimet on lukittu @lifeos/config-porttiin; uusi avain
# vaatii tietoisen katselmuksen ennen bundlea.

# Kanoninen origin. Dev: localhost. Tuotanto: täysi https-origin.
VITE_APP_ORIGIN=http://localhost:5173

# Julkinen Google OAuth client-id (EI secret — secretiä ei koskaan tähän).
VITE_GOOGLE_CLIENT_ID=dev-placeholder-client-id
